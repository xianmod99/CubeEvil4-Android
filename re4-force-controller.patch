   }
 
+  /** With "Force controller detection": a key of an external device, other than the phone's own system keys. */
+  static boolean forcedKey(android.view.InputEvent e) {
+    if (!(e instanceof KeyEvent)) return false;
+    InputDevice d = e.getDevice();
+    if (d == null || d.isVirtual()) return false;
+    switch (((KeyEvent) e).getKeyCode()) {
+      case KeyEvent.KEYCODE_BACK: case KeyEvent.KEYCODE_HOME: case KeyEvent.KEYCODE_POWER:
+      case KeyEvent.KEYCODE_VOLUME_UP: case KeyEvent.KEYCODE_VOLUME_DOWN: case KeyEvent.KEYCODE_VOLUME_MUTE:
+      case KeyEvent.KEYCODE_APP_SWITCH: case KeyEvent.KEYCODE_MENU: case KeyEvent.KEYCODE_CAMERA:
+      case KeyEvent.KEYCODE_SLEEP: case KeyEvent.KEYCODE_WAKEUP: case KeyEvent.KEYCODE_ASSIST:
+        return false;
+      default:
+        return true;
+    }
+  }
+
   /**
    * The touch controls' B pressed while the benchmark runs: it ends it as a controller's B does (0.99.17, users could
    * not end it by touch: the touch B went to the game as its button only, never to the benchmark's keys).
@@ -2067,6 +2102,7 @@ public final class CoreActivity extends Activity implements InputManager.InputDe
    * those without letters stay controllers.
    */
   static boolean keyboardSources(int s, int keyboardType) {
+    if (forceController) return false;
     if ((s & InputDevice.SOURCE_JOYSTICK) == InputDevice.SOURCE_JOYSTICK) return false;
     return (s & InputDevice.SOURCE_KEYBOARD) == InputDevice.SOURCE_KEYBOARD
         && keyboardType == InputDevice.KEYBOARD_TYPE_ALPHABETIC;
